{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "lib": ["ES2025", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "linocut",
    "paths": {
      "linocut/jsx-runtime": ["./src/jsx-runtime.ts"],
      "linocut/jsx-dev-runtime": ["./src/jsx-dev-runtime.ts"]
    },
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true
  },
  "include": ["src", "*.config.ts"]
}
