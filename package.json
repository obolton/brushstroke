{
  "name": "linocut",
  "version": "0.1.0",
  "description": "A small JSX runtime for reactive DOM and server rendering",
  "keywords": [
    "dom",
    "hydration",
    "jsx",
    "reactive",
    "ssr",
    "ui"
  ],
  "homepage": "https://github.com/obolton/linocut#readme",
  "bugs": {
    "url": "https://github.com/obolton/linocut/issues"
  },
  "license": "MIT",
  "author": "Oliver Bolton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obolton/linocut.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "typecheck": "tsc",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage",
    "prepublishOnly": "pnpm check",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "entities": "^8.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@vitest/coverage-v8": "^5.1.0",
    "carillon": "^0.1.3",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "carillon": "^0.1.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0"
}
